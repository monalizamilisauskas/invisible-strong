{%- comment -%}
  "What does your person need today?" — editorial cards built from real product photos.
  Each card = one collection (leave empty for all products):
  - big photo: the collection image, or the first product photo not used by a previous card
  - round thumbnails of the next products, piece count and starting price
  - tag, title, text and button editable per card
{%- endcomment -%}

{%- assign used = '|' -%}

<section class="is-nd" style="--nd-bg: {{ section.settings.background_color }};">
  {% render 'diary-butterflies', variant: 'flutter' %}
  <div class="is-nd__inner">
    <header class="is-nd__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="is-nd__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="is-nd__title">{{ section.settings.heading }}</h2>
      {% render 'diary-butterflies', variant: 'flourish' %}
      {%- if section.settings.subheading != blank -%}
        <p class="is-nd__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <div class="is-nd__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          if c == blank
            assign c = collections.all
          endif

          assign hero = nil
          assign hero_alt = ''
          assign thumbs = ''
          assign thumb_count = 0
          assign piece_count = 0
          assign min_price = nil

          for p in c.products limit: 50
            if p.title contains 'Package Protection'
              continue
            endif
            assign piece_count = piece_count | plus: 1
            if min_price == nil or p.price_min < min_price
              assign min_price = p.price_min
            endif
            if p.featured_image == blank
              continue
            endif
            assign key = '|' | append: p.handle | append: '|'
            if hero == nil and block.settings.image == blank and c.image == blank
              unless used contains key
                assign hero = p.featured_image
                assign hero_alt = p.title
                assign used = used | append: p.handle | append: '|'
                continue
              endunless
            endif
            if thumb_count < 3 and used contains key
              continue
            endif
            if thumb_count < 3
              assign used = used | append: p.handle | append: '|'
              capture t
                echo p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: p.title
              endcapture
              assign thumbs = thumbs | append: t
              assign thumb_count = thumb_count | plus: 1
            endif
          endfor

          if block.settings.image != blank
            assign hero = block.settings.image
            assign hero_alt = block.settings.title
          elsif c.image != blank
            assign hero = c.image
            assign hero_alt = c.title
          elsif hero == nil
            assign hero = c.products.first.featured_image
            assign hero_alt = c.products.first.title
          endif
        -%}
        {%- if piece_count > 0 -%}
          <a class="is-nd__card" href="{{ c.url }}" {{ block.shopify_attributes }}>
            {%- if hero -%}
              {{
                hero
                | image_url: width: 900
                | image_tag:
                  class: 'is-nd__bg',
                  loading: 'lazy',
                  widths: '400, 600, 900',
                  sizes: '(min-width: 990px) 380px, (min-width: 600px) 45vw, 82vw',
                  alt: hero_alt
              }}
            {%- endif -%}
            <div class="is-nd__panel">
              {%- if block.settings.tag != blank -%}
                <span class="is-nd__tag">{{ block.settings.tag }}</span>
              {%- endif -%}
              <h3 class="is-nd__name">{{ block.settings.title | default: c.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="is-nd__text">{{ block.settings.text }}</p>
              {%- endif -%}
              <div class="is-nd__row">
                <span class="is-nd__info">
                  {%- if thumbs != blank -%}<span class="is-nd__thumbs" aria-hidden="true">{{ thumbs }}</span>{%- endif -%}
                  <span class="is-nd__meta">
                    {{- piece_count }}
                    {% if piece_count == 1 %}piece{% else %}pieces{% endif -%}
                    {%- if block.settings.show_price and min_price %} · from {{ min_price | money }}{% endif -%}
                  </span>
                </span>
                {%- if block.settings.button_label != blank -%}
                  <span class="is-nd__btn">{{ block.settings.button_label }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .is-nd {
    position: relative;
    overflow: hidden;
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 84px 20px 92px;
    color: #3a3a3a;
    background:
      radial-gradient(circle at 10% 20%, rgba(201, 168, 106, 0.16), transparent 42%),
      radial-gradient(circle at 90% 80%, rgba(142, 107, 191, 0.2), transparent 48%),
      var(--nd-bg, #f5f0f7);
  }
  .is-nd * {
    box-sizing: border-box;
  }
  .is-nd__inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }
  .is-nd__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 44px;
  }
  .is-nd__eyebrow {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8e6bbf;
    margin: 0 0 10px;
  }
  .is-nd__title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 46px);
    line-height: 1.15;
    color: #5b3f8c;
    margin: 0 0 14px;
  }
  .is-nd__sub {
    font-size: 17px;
    line-height: 1.65;
    margin: 18px 0 0;
  }
  .is-nd__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .is-nd__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5.4;
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    color: #3a3a3a;
    background: #fff;
    box-shadow: 0 14px 40px rgba(91, 63, 140, 0.16);
  }
  .is-nd__card:focus-visible {
    outline: 2px solid #8e6bbf;
    outline-offset: 4px;
  }
  .is-nd__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .is-nd__card:hover .is-nd__bg {
    transform: scale(1.05);
  }
  .is-nd__panel {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    padding: 20px 20px 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(91, 63, 140, 0.12);
  }
  .is-nd__tag {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a6a2e;
    background: #f6efe2;
    border: 1px solid #e6d5b3;
    border-radius: 999px;
    padding: 4px 11px;
    margin-bottom: 10px;
  }
  .is-nd__name {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    color: #5b3f8c;
    margin: 0 0 6px;
  }
  .is-nd__text {
    font-size: 14.5px;
    line-height: 1.55;
    margin: 0 0 14px;
  }
  .is-nd__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .is-nd__info {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .is-nd__thumbs {
    display: flex;
    flex: 0 0 auto;
  }
  .is-nd__thumbs img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
    margin-left: -10px;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  .is-nd__thumbs img:first-child {
    margin-left: 0;
  }
  .is-nd__meta {
    font-size: 13px;
    color: #6f6670;
    margin-left: 8px;
  }
  .is-nd__btn {
    flex: 0 0 auto;
    background: #5b3f8c;
    color: #fff;
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .is-nd__card:hover .is-nd__btn {
    background: #4a2f75;
  }
  @media (max-width: 900px) {
    .is-nd__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .is-nd {
      padding: 56px 16px 64px;
    }
    .is-nd__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 14px;
      margin: 0 -16px;
      padding: 0 16px 8px;
      scrollbar-width: none;
    }
    .is-nd__card {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
    .is-nd__name {
      font-size: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-nd__bg {
      transition: none;
    }
    .is-nd__card:hover .is-nd__bg {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Needs cards",
  "tag": "div",
  "class": "is-nd-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find the right piece"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What does your person need today?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose the path that feels right — for them, or for you."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f0f7"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Leave empty to show all products."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Big photo (optional)",
          "info": "By default, uses the collection image or a real product photo from the collection."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop"
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show starting price",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Needs cards"
    }
  ]
}
{% endschema %}
