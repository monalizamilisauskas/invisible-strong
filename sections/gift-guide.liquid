{%- comment -%}
  Gift guide: one card per recipient, each pointing to a real product.
  Each card finds its product by the picker, or by matching part of the
  product title (e.g. "To My Mom") — so it keeps working if handles change.
  Photos are the real product photos, with an automatic fallback.
{%- endcomment -%}

<script>
  window.isGgFallback = window.isGgFallback || function (img) {
    var f = img.getAttribute('data-fallback');
    if (f && img.getAttribute('src') !== f) {
      img.setAttribute('src', f);
    }
  };
</script>

<section class="is-gg" style="--gg-bg: {{ section.settings.background_color }};">
  <div class="is-gg__inner">
    {%- if section.settings.heading != blank -%}
      <header class="is-gg__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="is-gg__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="is-gg__title">{{ section.settings.heading }}</h2>
        {% render 'diary-butterflies', variant: 'flourish' %}
      </header>
    {%- endif -%}

    <div class="is-gg__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          if p == blank and block.settings.match != blank
            for candidate in collections.all.products limit: 100
              if candidate.title contains block.settings.match
                assign p = candidate
                break
              endif
            endfor
          endif
        -%}
        {%- if p != blank -%}
          <a class="is-gg__card" href="{{ p.url }}" {{ block.shopify_attributes }}>
            <span class="is-gg__media">
              {%- if p.featured_image -%}
                <img
                  src="{{ p.featured_image | image_url: width: 700 }}"
                  data-fallback="{{ p.featured_image | image_url: width: 5760 }}"
                  alt="{{ p.title | escape }}"
                  width="700"
                  height="700"
                  loading="lazy"
                  onerror="isGgFallback(this)"
                >
              {%- endif -%}
              {%- if block.settings.recipient != blank -%}
                <span class="is-gg__tag">{{ block.settings.recipient }}</span>
              {%- endif -%}
            </span>
            <span class="is-gg__body">
              <span class="is-gg__name">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}
                <span class="is-gg__text">{{ block.settings.text }}</span>
              {%- endif -%}
              <span class="is-gg__product">
                {{- p.title -}}
                <span class="is-gg__price">
                  {%- if p.price_varies %} · from {{ p.price_min | money }}{% else %} · {{ p.price | money }}{% endif -%}
                </span>
              </span>
              <span class="is-gg__btn">{{ block.settings.button_label | default: 'See the piece' }} <span aria-hidden="true">→</span></span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_link_label != blank -%}
      <p class="is-gg__footer">
        <a href="{{ section.settings.footer_link | default: routes.all_products_collection_url }}">
          {{- section.settings.footer_link_label }} <span aria-hidden="true">→</span>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .is-gg {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 40px 20px 72px;
    background: var(--gg-bg, #f7f2ec);
    color: #3a3a3a;
  }
  .is-gg * {
    box-sizing: border-box;
  }
  .is-gg__inner {
    max-width: 1160px;
    margin: 0 auto;
  }
  .is-gg__head {
    text-align: center;
    margin: 0 auto 36px;
  }
  .is-gg__eyebrow {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8e6bbf;
    margin: 0 0 10px;
  }
  .is-gg__title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 40px);
    color: #5b3f8c;
    margin: 0 0 14px;
  }
  .is-gg__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }
  .is-gg__card {
    flex: 0 1 calc((100% - 48px) / 3);
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #ece3f3;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 8px 26px rgba(91, 63, 140, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .is-gg__card:hover,
  .is-gg__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(91, 63, 140, 0.16);
  }
  .is-gg__card:focus-visible {
    outline: 2px solid #8e6bbf;
    outline-offset: 3px;
  }
  .is-gg__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: #f5f0f7;
    overflow: hidden;
  }
  .is-gg__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .is-gg__card:hover .is-gg__media img {
    transform: scale(1.04);
  }
  .is-gg__tag {
    position: absolute;
    left: 14px;
    top: 14px;
    background: rgba(255, 255, 255, 0.92);
    color: #5b3f8c;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(91, 63, 140, 0.12);
  }
  .is-gg__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    padding: 22px 24px 24px;
  }
  .is-gg__name {
    display: block;
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: 26px;
    line-height: 1.2;
    color: #5b3f8c;
  }
  .is-gg__text {
    display: block;
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    color: #5b3f8c;
    opacity: 0.85;
  }
  .is-gg__product {
    display: block;
    flex: 1;
    font-size: 14px;
    line-height: 1.5;
    color: #6f6670;
    margin-top: 4px;
  }
  .is-gg__price {
    color: #3a3a3a;
    font-weight: 600;
  }
  .is-gg__btn {
    align-self: flex-start;
    margin-top: 8px;
    background: #5b3f8c;
    color: #fff;
    border-radius: 999px;
    padding: 11px 22px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .is-gg__card:hover .is-gg__btn {
    background: #4a2f75;
  }
  .is-gg__footer {
    text-align: center;
    margin: 40px 0 0;
  }
  .is-gg__footer a {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #5b3f8c;
    text-decoration: none;
    border-bottom: 1.5px solid #c9a86a;
    padding-bottom: 2px;
  }
  @media (max-width: 900px) {
    .is-gg__card {
      flex-basis: calc((100% - 24px) / 2);
    }
  }
  @media (max-width: 600px) {
    .is-gg {
      padding: 28px 16px 56px;
    }
    .is-gg__grid {
      gap: 16px;
    }
    .is-gg__card {
      flex-basis: 100%;
    }
    .is-gg__name {
      font-size: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-gg__card,
    .is-gg__media img {
      transition: none;
    }
    .is-gg__card:hover,
    .is-gg__card:hover .is-gg__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift guide",
  "tag": "div",
  "class": "is-gg-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "footer_link_label",
      "label": "Bottom link label",
      "default": "Not sure yet? Browse every piece"
    },
    {
      "type": "url",
      "id": "footer_link",
      "label": "Bottom link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f2ec"
    }
  ],
  "blocks": [
    {
      "type": "recipient",
      "name": "Recipient",
      "settings": [
        {
          "type": "text",
          "id": "recipient",
          "label": "Tag on the photo",
          "default": "For Mom"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "For Mom"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short line"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "match",
          "label": "Or: part of the product title",
          "info": "Used when no product is selected, e.g. \"To My Mom\"."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "See the necklace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift guide"
    }
  ]
}
{% endschema %}
