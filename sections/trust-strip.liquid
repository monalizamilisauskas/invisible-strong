{%- comment -%}
  Slim trust strip: up to 3 items, each with an icon in a soft circle,
  a short title and one line of detail.
{%- endcomment -%}

<section class="is-trust-strip" style="--strip-bg: {{ section.settings.background_color }};">
  <ul class="is-trust-strip__list" role="list">
    {%- for block in section.blocks -%}
      <li class="is-trust-strip__item" {{ block.shopify_attributes }}>
        <span class="is-trust-strip__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'card' -%}
              <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {%- when 'gift' -%}
              <svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M12 8v13M3 12h18M12 8c-1.5-3-5-3.5-5-1s3 1 5 1c2 0 5 1.5 5-1s-3.5-2-5 1"/></svg>
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
          {%- endcase -%}
        </span>
        <span class="is-trust-strip__copy">
          <span class="is-trust-strip__title">{{ block.settings.title }}</span>
          {%- if block.settings.text != blank -%}
            <span class="is-trust-strip__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .is-trust-strip {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 28px 20px 36px;
    background: var(--strip-bg, #f7f2ec);
    color: #3a3a3a;
  }
  .is-trust-strip__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    background: #fff;
    border: 1px solid #ece3f3;
    border-radius: 18px;
    box-shadow: 0 6px 24px rgba(91, 63, 140, 0.06);
  }
  .is-trust-strip__item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 26px;
  }
  .is-trust-strip__item + .is-trust-strip__item {
    border-left: 1px solid #efe7f5;
  }
  .is-trust-strip__icon {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #efe7f5 0%, #f5ecdf 100%);
  }
  .is-trust-strip__icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #5b3f8c;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .is-trust-strip__copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .is-trust-strip__title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: 18px;
    line-height: 1.3;
    color: #5b3f8c;
  }
  .is-trust-strip__text {
    font-size: 14px;
    line-height: 1.45;
    color: #5f5866;
  }
  @media (max-width: 760px) {
    .is-trust-strip {
      padding: 20px 16px 28px;
    }
    .is-trust-strip__list {
      grid-template-columns: 1fr;
    }
    .is-trust-strip__item {
      padding: 16px 18px;
    }
    .is-trust-strip__item + .is-trust-strip__item {
      border-left: 0;
      border-top: 1px solid #efe7f5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust strip",
  "tag": "div",
  "class": "is-trust-strip-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f2ec"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "card", "label": "Message card" },
            { "value": "gift", "label": "Gift box" },
            { "value": "truck", "label": "Shipping" },
            { "value": "shield", "label": "Protection" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Detail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "card", "title": "Message card & gift box", "text": "With every jewelry piece" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Free US shipping", "text": "On orders $95+" } },
        { "type": "item", "settings": { "icon": "shield", "title": "We've got you", "text": "Lost, damaged or wrong item? We'll replace it free." } }
      ]
    }
  ]
}
{% endschema %}
