{%- comment -%}
  Home hero slideshow: lifestyle images (or a video) of people wearing the pieces.
  - Slides fade every N seconds; pause on hover/focus; arrows + dots.
  - Desktop: text over the image (soft cream gradient on the left).
  - Mobile: image on top, text below on the cream background.
  - Respects "reduce motion": no auto-advance and videos paused.
{%- endcomment -%}

{%- liquid
  assign slide_count = 0
  for b in section.blocks
    if b.settings.image != blank or b.settings.video != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  class="is-hs"
  id="is-hs-{{ section.id }}"
  data-is-hs
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed | times: 1000 }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | escape }}"
  style="--hs-overlay: rgba(247, 242, 236, {{ overlay_alpha }}); --hs-bg: {{ section.settings.background_color }};"
>
  <div class="is-hs__track">
    {%- assign slide_i = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.image == blank and block.settings.video == blank -%}{%- continue -%}{%- endif -%}
      {%- assign slide_i = slide_i | plus: 1 -%}
      {%- liquid
        assign is_first = false
        if slide_i == 1
          assign is_first = true
        endif
        assign pos_y = block.settings.image_position | default: 'center'
        assign focus_x = block.settings.mobile_focus_x | default: 50
        assign poster = nil
        if block.settings.image != blank
          assign poster = block.settings.image | image_url: width: 1920
        endif
      -%}
      <div
        class="is-hs__slide{% if is_first %} is-active{% endif %}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ slide_i }} / {{ slide_count }}"
        {% unless is_first %}aria-hidden="true"{% endunless %}
        style="--hs-pos-y: {{ pos_y }}; --hs-focus-x: {{ focus_x }}%;"
        data-is-hs-slide
        {{ block.shopify_attributes }}
      >
        <div class="is-hs__media">
          {%- if block.settings.video != blank -%}
            {{
              block.settings.video
              | video_tag:
                poster: poster,
                autoplay: is_first,
                loop: true,
                controls: false,
                muted: true,
                playsinline: true,
                class: 'is-hs__img',
                data-is-hs-video: ''
            }}
          {%- elsif block.settings.image != blank -%}
            {%- liquid
              if is_first
                assign loading = 'eager'
                assign priority = 'high'
              else
                assign loading = 'lazy'
                assign priority = 'auto'
              endif
            -%}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'is-hs__img',
                widths: '600, 900, 1200, 1600, 2000, 2400',
                sizes: '100vw',
                loading: loading,
                fetchpriority: priority,
                alt: block.settings.image.alt
            }}
          {%- else -%}
            <div class="is-hs__img is-hs__img--empty"></div>
          {%- endif -%}
          <span class="is-hs__overlay" aria-hidden="true"></span>
        </div>

        <div class="is-hs__content">
          <div class="is-hs__content-inner">
            {%- if block.settings.title != blank -%}
              {%- if is_first -%}
                <h1 class="is-hs__title">{{ block.settings.title | newline_to_br }}</h1>
              {%- else -%}
                <h2 class="is-hs__title">{{ block.settings.title | newline_to_br }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="is-hs__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                class="is-hs__btn"
                href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                {% unless is_first %}tabindex="-1"{% endunless %}
              >
                {{- block.settings.button_label -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="is-hs__controls">
      <button type="button" class="is-hs__arrow is-hs__arrow--prev" data-is-hs-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
      </button>
      <div class="is-hs__dots">
        {%- for i in (1..slide_count) -%}
          <button
            type="button"
            class="is-hs__dot{% if forloop.first %} is-active{% endif %}"
            data-is-hs-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {%- endfor -%}
      </div>
      <button type="button" class="is-hs__arrow is-hs__arrow--next" data-is-hs-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('is-hs-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-is-hs-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-is-hs-dot]'));
    if (slides.length < 2) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var autoplay = root.dataset.autoplay === 'true' && !reduce;
    var speed = parseInt(root.dataset.speed, 10) || 6000;
    var current = 0;
    var timer = null;
    var paused = false;

    if (reduce) {
      root.querySelectorAll('[data-is-hs-video]').forEach(function (v) { v.removeAttribute('autoplay'); v.pause(); });
    }

    function show(index) {
      index = (index + slides.length) % slides.length;
      slides.forEach(function (s, i) {
        var active = i === index;
        s.classList.toggle('is-active', active);
        if (active) { s.removeAttribute('aria-hidden'); } else { s.setAttribute('aria-hidden', 'true'); }
        s.querySelectorAll('a').forEach(function (a) { if (active) { a.removeAttribute('tabindex'); } else { a.setAttribute('tabindex', '-1'); } });
        var video = s.querySelector('[data-is-hs-video]');
        if (video && !reduce) {
          if (active) { var p = video.play(); if (p && p.catch) p.catch(function () {}); } else { video.pause(); }
        }
      });
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === index);
        if (i === index) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); }
      });
      current = index;
    }
    function start() {
      if (!autoplay) return;
      stop();
      timer = setInterval(function () { if (!paused && !document.hidden) show(current + 1); }, speed);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    var prev = root.querySelector('[data-is-hs-prev]');
    var next = root.querySelector('[data-is-hs-next]');
    if (prev) prev.addEventListener('click', function () { show(current - 1); start(); });
    if (next) next.addEventListener('click', function () { show(current + 1); start(); });
    dots.forEach(function (d) { d.addEventListener('click', function () { show(parseInt(d.dataset.isHsDot, 10)); start(); }); });

    root.addEventListener('mouseenter', function () { paused = true; });
    root.addEventListener('mouseleave', function () { paused = false; });
    root.addEventListener('focusin', function () { paused = true; });
    root.addEventListener('focusout', function () { paused = false; });

    // Swipe on touch screens
    var startX = null;
    root.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) { show(current + (dx < 0 ? 1 : -1)); start(); }
      startX = null;
    });

    start();
  })();
</script>

{% stylesheet %}
  .is-hs {
    position: relative;
    display: block;
    width: 100%;
    background: var(--hs-bg, #f7f2ec);
    color: #3a3a3a;
    overflow: hidden;
  }
  .is-hs * {
    box-sizing: border-box;
  }
  .is-hs__track {
    display: grid;
  }
  .is-hs__slide {
    grid-area: 1 / 1;
    position: relative;
    height: clamp(520px, 66vh, 660px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.1s ease, visibility 0s linear 1.1s;
  }
  .is-hs__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.1s ease, visibility 0s;
    z-index: 1;
  }
  .is-hs__media {
    position: absolute;
    inset: 0;
  }
  .is-hs__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--hs-pos-y, center);
    display: block;
  }
  .is-hs__img--empty {
    background: linear-gradient(135deg, #efe7f5, #f5ecdf);
  }
  .is-hs__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--hs-overlay), rgba(247, 242, 236, 0));
    pointer-events: none;
  }
  .is-hs__content {
    position: relative;
    z-index: 1;
    height: 100%;
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 max(var(--page-margin, 20px), 20px) 96px;
    display: flex;
    align-items: flex-end;
  }
  .is-hs__content-inner {
    max-width: 520px;
  }
  .is-hs__title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-weight: 400;
    font-size: clamp(38px, 4.4vw, 60px);
    line-height: 1.06;
    color: #5b3f8c;
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .is-hs__text {
    font-size: 16px;
    line-height: 1.65;
    margin: 0 0 24px;
    max-width: 440px;
  }
  .is-hs__btn {
    display: inline-block;
    background: #5b3f8c;
    color: #fff;
    border-radius: 999px;
    padding: 15px 28px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }
  .is-hs__btn:hover,
  .is-hs__btn:focus-visible {
    background: #4a2f75;
  }
  .is-hs__controls {
    position: absolute;
    z-index: 2;
    left: max(var(--page-margin, 20px), 20px, calc((100% - var(--page-width, 1400px)) / 2 + var(--page-margin, 20px)));
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 16px rgba(91, 63, 140, 0.12);
  }
  .is-hs__arrow {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #d9c9ec;
    background: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
  }
  .is-hs__arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #5b3f8c;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .is-hs__arrow:hover {
    border-color: #8e6bbf;
  }
  .is-hs__dots {
    display: flex;
    gap: 8px;
  }
  .is-hs__dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: #d9c9ec;
    cursor: pointer;
    transition: width 0.3s, background 0.3s;
  }
  .is-hs__dot.is-active {
    width: 26px;
    background: #5b3f8c;
  }
  .is-hs :is(.is-hs__arrow, .is-hs__dot, .is-hs__btn):focus-visible {
    outline: 2px solid #8e6bbf;
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .is-hs__slide {
      height: auto;
    }
    .is-hs__media {
      position: relative;
      height: 100vw;
      max-height: 520px;
    }
    .is-hs__img {
      object-position: var(--hs-focus-x, 50%) top;
    }
    .is-hs__overlay {
      display: none;
    }
    .is-hs__content {
      height: auto;
      padding: 26px 20px 44px;
      display: block;
    }
    .is-hs__title {
      font-size: 38px;
    }
    .is-hs__controls {
      left: 50%;
      bottom: auto;
      top: calc(min(100vw, 520px) - 46px);
      transform: translateX(-50%);
    }
    .is-hs__arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-hs__slide,
    .is-hs__slide.is-active {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "div",
  "class": "is-hs-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Change slides automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per slide",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Text background strength (desktop)",
      "info": "Soft cream gradient on the left that keeps the text readable.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Featured pieces"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f2ec"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Also used as the poster while a video loads."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional)"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position (desktop)",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "20%", "label": "20% from top" },
            { "value": "30%", "label": "30% from top" },
            { "value": "40%", "label": "40% from top" },
            { "value": "center", "label": "Center" },
            { "value": "60%", "label": "60% from top" },
            { "value": "70%", "label": "70% from top" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "mobile_focus_x",
          "label": "Mobile: horizontal focus",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 70
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "info": "Press Enter for a line break."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow"
    }
  ]
}
{% endschema %}
