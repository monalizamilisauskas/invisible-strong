{%- comment -%}
  Generic page in the Invisible Strong style (FAQ, Contact, etc.).
  - Warm hero: eyebrow, title (page title by default), intro.
  - Page content below, in one of two styles:
    reading → comfortable reading column
    faq     → each heading (h2/h3/h4) becomes a question that opens and closes
  The text always comes from the page content in the Shopify admin.
{%- endcomment -%}

<article
  class="is-soft-page is-soft-page--{{ section.settings.content_style }}"
  style="--soft-bg: {{ section.settings.background_color }};"
>
  <header class="is-soft-page__hero">
    {% render 'diary-butterflies', variant: 'flutter' %}
    <div class="is-soft-page__hero-inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="is-soft-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="is-soft-page__title">{{ section.settings.heading | default: page.title }}</h1>
      {% render 'diary-butterflies', variant: 'flourish' %}
      {%- if section.settings.intro != blank -%}
        <div class="is-soft-page__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>
  </header>

  {%- if section.settings.show_content and page.content != blank -%}
    <div class="is-soft-page__inner">
      <div class="is-soft-page__body" data-soft-page-body>
        {{ page.content }}
      </div>
    </div>
  {%- endif -%}
</article>

{%- if section.settings.content_style == 'faq' -%}
  <script>
    (function () {
      function isQuestionParagraph(el) {
        // <p><strong>Question?</strong></p>  (or <b>)
        if (el.tagName !== 'P') return false;
        var strong = el.querySelector(':scope > strong, :scope > b');
        if (!strong) return false;
        var text = el.textContent.trim();
        var boldText = strong.textContent.trim();
        return text.length > 0 && text.length < 200 && (text === boldText || /\?$/.test(boldText));
      }
      function isQuestion(el) {
        return /^H[2-4]$/.test(el.tagName) || isQuestionParagraph(el);
      }
      function buildItem(summaryHtml, nodes) {
        var details = document.createElement('details');
        details.className = 'is-faq-item';
        var summary = document.createElement('summary');
        summary.innerHTML = summaryHtml;
        var panel = document.createElement('div');
        panel.className = 'is-faq-item__answer';
        nodes.forEach(function (n) { panel.appendChild(n); });
        details.appendChild(summary);
        details.appendChild(panel);
        return details;
      }
      document.querySelectorAll('.is-soft-page--faq [data-soft-page-body]').forEach(function (body) {
        if (body.dataset.faqReady) return;
        body.dataset.faqReady = 'true';
        var root = body;
        while (root.children.length === 1 && /^(DIV|SECTION|ARTICLE)$/.test(root.children[0].tagName)) {
          root = root.children[0];
        }

        // 1) Questions that already open and close (<details>): restyle them
        var existing = root.querySelectorAll('details');
        if (existing.length) {
          existing.forEach(function (d) {
            var summary = d.querySelector(':scope > summary');
            if (!summary) return;
            var rest = Array.prototype.slice.call(d.childNodes).filter(function (n) { return n !== summary; });
            var item = buildItem(summary.textContent.trim(), rest);
            d.replaceWith(item);
          });
        } else {
          // 2) Headings (h2/h3/h4) or bold paragraphs become questions
          var children = Array.prototype.slice.call(root.children);
          var questions = children.filter(isQuestion);
          if (!questions.length) return;
          questions.forEach(function (q) {
            var answer = [];
            var next = q.nextElementSibling;
            while (next && !isQuestion(next) && next.tagName !== 'H1') {
              answer.push(next);
              next = next.nextElementSibling;
            }
            var label = isQuestionParagraph(q) ? q.textContent.trim() : q.innerHTML;
            var item = buildItem(label, answer);
            q.replaceWith(item);
          });
        }
        var first = root.querySelector('.is-faq-item');
        if (first) first.open = true;
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .is-soft-page {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: var(--soft-bg, #f7f2ec);
    color: #3a3a3a;
  }
  .is-soft-page * {
    box-sizing: border-box;
  }
  .is-soft-page__hero {
    position: relative;
    overflow: hidden;
    padding: 64px 20px 52px;
    text-align: center;
    background:
      radial-gradient(circle at 12% 25%, rgba(201, 168, 106, 0.18), transparent 45%),
      radial-gradient(circle at 88% 10%, rgba(142, 107, 191, 0.22), transparent 50%),
      linear-gradient(180deg, #efe7f5 0%, var(--soft-bg, #f7f2ec) 100%);
  }
  .is-soft-page__hero-inner {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
  }
  .is-soft-page__eyebrow {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8e6bbf;
    margin: 0 0 12px;
  }
  .is-soft-page__title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.15;
    color: #5b3f8c;
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .is-soft-page__intro {
    font-size: 18px;
    line-height: 1.7;
    margin: 18px auto 0;
    max-width: 560px;
  }
  .is-soft-page__intro p {
    margin: 0;
  }
  .is-soft-page__inner {
    max-width: 68ch;
    margin: 0 auto;
    padding: 32px 20px 88px;
  }
  .is-soft-page__body {
    font-size: 18px;
    line-height: 1.8;
  }
  .is-soft-page__body > div,
  .is-soft-page__body > section {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
  }
  .is-soft-page__body p {
    margin: 0 0 1.2em;
  }
  .is-soft-page__body h2,
  .is-soft-page__body h3,
  .is-soft-page__body h4 {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-weight: 400;
    color: #5b3f8c;
    line-height: 1.35;
    margin: 1.8em 0 0.7em;
  }
  .is-soft-page__body h2 {
    font-size: clamp(24px, 2.8vw, 30px);
  }
  .is-soft-page__body h3,
  .is-soft-page__body h4 {
    font-size: 22px;
  }
  .is-soft-page__body a {
    color: #5b3f8c;
    text-decoration-color: #c9a86a;
  }
  .is-soft-page__body ul,
  .is-soft-page__body ol {
    padding-left: 1.2em;
    margin: 0 0 1.2em;
  }

  /* FAQ: questions that open and close */
  .is-faq-item {
    background: #fff;
    border: 1px solid #ece3f3;
    border-radius: 16px;
    margin: 0 0 14px;
    box-shadow: 0 4px 18px rgba(91, 63, 140, 0.05);
    transition: box-shadow 0.2s;
  }
  .is-faq-item[open] {
    box-shadow: 0 8px 26px rgba(91, 63, 140, 0.1);
  }
  .is-faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: 20px;
    line-height: 1.4;
    color: #5b3f8c;
  }
  .is-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .is-faq-item summary::after {
    content: '+';
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #f5f0f7;
    color: #c9a86a;
    font-family: var(--font-body--family, Lato, sans-serif);
    font-size: 22px;
    line-height: 1;
  }
  .is-faq-item[open] summary::after {
    content: '−';
  }
  .is-faq-item summary:focus-visible {
    outline: 2px solid #8e6bbf;
    outline-offset: 2px;
    border-radius: 16px;
  }
  .is-faq-item__answer {
    padding: 0 24px 20px;
    font-size: 17px;
    line-height: 1.75;
  }
  .is-faq-item__answer > :last-child {
    margin-bottom: 0;
  }

  /* Contact form in the brand style (contact page) */
  .contact-form {
    box-sizing: border-box;
    max-width: 100%;
    background: #fff;
    border: 1px solid #ece3f3;
    border-radius: 18px;
    padding: 32px 28px;
    box-shadow: 0 6px 24px rgba(91, 63, 140, 0.07);
  }
  .contact-form .contact-form__form,
  .contact-form .contact-form__form-row,
  .contact-form .contact-form__form-row > * {
    min-width: 0;
    max-width: 100%;
  }
  .contact-form .contact-form__input {
    box-sizing: border-box;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border: 1px solid #d9c9ec;
    border-radius: 12px;
    background: #fbf8fd;
    padding: 14px 16px;
    font-size: 16px;
  }
  .contact-form .contact-form__input:focus {
    outline: none;
    border-color: #8e6bbf;
    box-shadow: 0 0 0 3px rgba(142, 107, 191, 0.18);
  }

  @media (max-width: 640px) {
    .is-soft-page__hero {
      padding: 44px 18px 36px;
    }
    .is-soft-page__inner {
      padding: 24px 16px 64px;
    }
    .is-soft-page__body {
      font-size: 17px;
    }
    .is-faq-item summary {
      font-size: 18px;
      padding: 18px 18px;
    }
    .is-faq-item__answer {
      padding: 0 18px 18px;
      font-size: 16px;
    }
    .contact-form {
      padding: 24px 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Soft page",
  "tag": "div",
  "class": "is-soft-page-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show page content",
      "default": true
    },
    {
      "type": "select",
      "id": "content_style",
      "label": "Content style",
      "options": [
        { "value": "reading", "label": "Reading" },
        { "value": "faq", "label": "FAQ (headings open and close)" }
      ],
      "default": "reading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f2ec"
    }
  ],
  "presets": [
    {
      "name": "Soft page"
    }
  ]
}
{% endschema %}
