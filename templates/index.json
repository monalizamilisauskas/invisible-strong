"","open_in_new_tab":false,"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"space-between","vertical_alignment":"flex-end","align_baseline":true,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"flex-end","gap":24,"section_width":"page-width","section_height":"large","section_height_custom":50,"background_color":"#f7f2ec","toggle_overlay":true,"overlay_color":"#f7f2ec","overlay_style":"gradient","gradient_direction":"to right","blurred_reflection":false,"reflection_opacity":25,"padding-block-start":100,"padding-block-end":75,"mobile_media_above":true,"mobile_focus_x":80}},"custom_liquid_zrdA3C":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .is-shop{display:block;width:100%;box-sizing:border-box;background:#F7F2EC;padding:72px 20px 80px}\n  .is-shop *{box-sizing:border-box}\n  .is-shop__inner{width:100%;max-width:1100px;margin:0 auto}\n  .is-shop__eyebrow{text-align:center;font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:#8E6BBF;margin:0 0 10px}\n  .is-shop__title{text-align:center;font-family:\"Playfair Display\",Georgia,serif;font-size:clamp(28px,3.4vw,42px);color:#5B3F8C;margin:0 0 12px;font-weight:400}\n  .is-shop__sub{text-align:center;color:#3A3A3A;font-size:16px;margin:0 auto 44px;max-width:560px;line-height:1.6}\n  .is-shop__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,340px));justify-content:center;gap:28px;width:100%}\n  .is-card{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 6px 24px rgba(91,63,140,.08);display:flex;flex-direction:column;transition:transform .25s ease,box-shadow .25s ease;text-decoration:none;width:100%}\n  .is-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(91,63,140,.16)}\n  .is-card__img{aspect-ratio:1/1;overflow:hidden;background:#EFE7F5}\n  .is-card__img img{width:100%;height:100%;object-fit:cover;display:block}\n  .is-card__body{padding:20px 22px 24px;display:flex;flex-direction:column;gap:8px;flex:1}\n  .is-card__tag{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#C9A86A;margin:0}\n  .is-card__name{font-family:\"Playfair Display\",Georgia,serif;font-size:20px;line-height:1.3;color:#5B3F8C;margin:0;font-weight:600}\n  .is-card__price{font-size:17px;color:#3A3A3A;font-weight:600;margin:0}\n  .is-card__btn{margin-top:8px;align-self:flex-start;background:#8E6BBF;color:#fff;border-radius:999px;padding:11px 22px;font-size:15px;font-weight:600}\n  .is-card:hover .is-card__btn{background:#5B3F8C}\n  @media(max-width:560px){.is-shop{padding:52px 16px 60px}.is-shop__grid{grid-template-columns:1fr}.is-card__name{font-size:19px}}\n</style>\n\n<section class=\"is-shop\">\n  <div class=\"is-shop__inner\">\n    <p class=\"is-shop__eyebrow\">Best sellers</p>\n    <h2 class=\"is-shop__title\">Most loved pieces</h2>\n    <p class=\"is-shop__sub\">The pieces our community reaches for most — a quiet way to tell someone you see what others can't.</p>\n    <div class=\"is-shop__grid\">\n      {%- assign is_src = collections['best-sellers'] -%}\n      {%- if is_src == blank or is_src.products_count == 0 -%}{%- assign is_src = collections.all -%}{%- endif -%}\n      {%- assign is_shown = 0 -%}\n      {% for product in is_src.products limit: 12 %}\n        {% if is_shown < 6 %}{% unless product.title contains 'Package Protection' %}{%- assign is_shown = is_shown | plus: 1 -%}\n          <a class=\"is-card\" href=\"{{ product.url }}\">\n            <div class=\"is-card__img\">\n              {% if product.featured_image %}\n                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}\n              {% endif %}\n            </div>\n            <div class=\"is-card__body\">\n              {% unless product.tags contains 'no-message-card' %}<p class=\"is-card__tag\">With message card</p>{% endunless %}\n              <h3 class=\"is-card__name\">{{ product.title }}</h3>\n              <p class=\"is-card__price\">\n                {% if product.price_varies %}From {{ product.price_min | money }}{% else %}{{ product.price | money }}{% endif %}\n              </p>\n              <span class=\"is-card__btn\">View piece</span>\n            </div>\n          </a>\n        {% endunless %}{% endif %}\n      {% endfor %}\n    </div>\n  </div>\n</section>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_RUqFEM":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .is-spoon{display:block;width:100%;box-sizing:border-box;background:#F7F2EC;padding:80px 20px 72px;text-align:center}\n  .is-spoon__inner{max-width:760px;margin:0 auto}\n  .is-spoon__eyebrow{font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:#8E6BBF;margin:0 0 14px}\n  .is-spoon__title{font-family:\"Playfair Display\",Georgia,serif;font-size:clamp(30px,4vw,48px);color:#5B3F8C;font-weight:400;line-height:1.2;margin:0 0 28px}\n  .is-spoon__row{display:flex;justify-content:center;gap:18px;margin:0 0 30px}\n  .is-spoon__row svg{width:34px;height:auto}\n  .is-spoon__row .on path{fill:#8E6BBF}\n  .is-spoon__row .off path{fill:#E4D8EE}\n  .is-spoon__text{font-size:18px;line-height:1.7;color:#3A3A3A;margin:0 auto 32px;max-width:620px}\n  .is-spoon__btn{display:inline-block;background:#8E6BBF;color:#fff;border-radius:999px;padding:14px 30px;font-size:16px;font-weight:600;text-decoration:none;transition:background .2s}\n  .is-spoon__btn:hover{background:#5B3F8C}\n  @media(max-width:560px){.is-spoon{padding:56px 18px 52px}.is-spoon__row{gap:12px}.is-spoon__row svg{width:26px}.is-spoon__text{font-size:16px}}\n</style>\n\n<section class=\"is-spoon\">\n  <div class=\"is-spoon__inner\">\n    <p class=\"is-spoon__eyebrow\">The Spoon Theory</p>\n    <h2 class=\"is-spoon__title\">Some days, we only have a few spoons.</h2>\n    <div class=\"is-spoon__row\" aria-hidden=\"true\">\n      {% for i in (1..6) %}\n        <svg class=\"{% if i <= 2 %}on{% else %}off{% endif %}\" viewBox=\"0 0 40 120\"><path d=\"M20 4c-9 0-15 9-15 20 0 9 5 16 11 18v66a4 4 0 0 0 8 0V42c6-2 11-9 11-18C35 13 29 4 20 4z\"/></svg>\n      {% endfor %}\n    </div>\n    <p class=\"is-spoon__text\">People living with chronic illness often describe their daily energy as a handful of spoons. Every task costs one — getting dressed, cooking, answering a message. When the spoons run out, the day is over, even if no one else can see it. Every piece here is a quiet way to say: <strong>I understand.</strong></p>\n    <a class=\"is-spoon__btn\" href=\"/collections/all\">Find Your Piece</a>\n  </div>\n</section>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"section_tpiMfG":{"type":"section","blocks":{"text_CgCH6c":{"type":"text","name":"t:names.heading","settings":{"text":"<h2>Join the Spoon Diary</h2>","width":"100%","max_width":"normal","alignment":"center","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"#5b3f8c","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_GnDVwH":{"type":"text","settings":{"text":"<p>Gentle notes for low-spoon days, stories from our community and first access to new pieces. No spam — just support.</p>","width":"100%","max_width":"normal","alignment":"center","type_preset":"paragraph","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"email_signup_N6M9FM":{"type":"email-signup","settings":{"width":"custom","custom_width":50,"heading":"","heading_text_color":"","heading_preset":"h3","border_style":"all","input_style":"custom","border_width":1,"border_radius":100,"input_background_color":"","input_text_color":"","input_border_color":"#c9b6e0","input_type_preset":"paragraph","style_class":"button","custom_button_background":"{{ settings.color_palette.foreground }}","custom_button_text":"{{ settings.color_palette.background }}","custom_button_border":"{{ settings.color_palette.background }}","link_text_color":"","display_type":"text","label":"Join","integrated_button":true,"button_type_preset":"paragraph","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_CgCH6c","text_GnDVwH","email_signup_N6M9FM"],"name":"t:names.email_signup","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":16,"section_width":"page-width","section_height":"","section_height_custom":50,"background_media":"none","background_color":"","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":16,"padding-block-end":40}},"custom_liquid_needs":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\n  .is-needs{display:block;width:100%;box-sizing:border-box;background:transparent;padding:64px 20px 24px}\n  .is-needs *{box-sizing:border-box}\n  .is-needs__inner{max-width:1100px;margin:0 auto}\n  .is-needs__eyebrow{text-align:center;font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:#8E6BBF;margin:0 0 10px}\n  .is-needs__title{text-align:center;font-family:\"Playfair Display\",Georgia,serif;font-size:clamp(28px,3.4vw,42px);color:#5B3F8C;margin:0 0 40px;font-weight:400}\n  .is-needs__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,340px));justify-content:center;gap:28px}\n  .is-need{display:flex;flex-direction:column;background:#fff;border-radius:18px;overflow:hidden;text-decoration:none;box-shadow:0 6px 24px rgba(91,63,140,.08);transition:transform .25s ease,box-shadow .25s ease}\n  .is-need:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(91,63,140,.16)}\n  .is-need__img{aspect-ratio:1/1;overflow:hidden;background:#EFE7F5}\n  .is-need__img img{width:100%;height:100%;object-fit:cover;display:block}\n  .is-need__body{padding:22px 24px 26px;display:flex;flex-direction:column;gap:8px;flex:1}\n  .is-need__name{font-family:\"Playfair Display\",Georgia,serif;font-size:22px;line-height:1.3;margin:0;font-weight:400;color:#5B3F8C}\n  .is-need__text{font-size:15px;line-height:1.55;margin:0;color:#3A3A3A;flex:1}\n  .is-need__cta{margin-top:8px;align-self:flex-start;font-size:14px;font-weight:600;letter-spacing:.04em;color:#5B3F8C;border-bottom:1.5px solid #C9A86A;padding-bottom:2px}\n  @media(max-width:560px){.is-needs{padding:48px 16px 16px}.is-needs__grid{grid-template-columns:1fr}}\n</style>\n{%- assign is_need_count = 0 -%}\n{%- capture is_need_cards -%}\n  {%- assign needs = 'gifts-that-say-i-believe-you|for-spoon-days|gift-sets' | split: '|' -%}\n  {%- for handle in needs -%}\n    {%- assign c = collections[handle] -%}\n    {%- assign c_count = 0 -%}\n    {%- if c.handle == handle -%}{%- assign c_count = c.products_count | plus: 0 -%}{%- endif -%}\n    {%- if c_count > 0 -%}\n      {%- assign is_need_count = is_need_count | plus: 1 -%}\n      {%- case handle -%}\n        {%- when 'gifts-that-say-i-believe-you' -%}{%- assign n_title = 'Gifts that say “I believe you”' -%}{%- assign n_text = 'Jewelry with a heartfelt message card, ready to give.' -%}\n        {%- when 'for-spoon-days' -%}{%- assign n_title = 'For spoon days' -%}{%- assign n_text = 'Soft, cozy pieces for the days you need to rest.' -%}\n        {%- when 'gift-sets' -%}{%- assign n_title = 'Gift sets' -%}{%- assign n_text = 'A complete, ready-to-give gift for someone you love.' -%}\n      {%- endcase -%}\n      {%- assign n_img = c.image | default: c.products.first.featured_image -%}\n      <a class=\"is-need\" href=\"{{ c.url }}\">\n        <div class=\"is-need__img\">{%- if n_img -%}{{ n_img | image_url: width: 800 | image_tag: loading: 'lazy', alt: n_title }}{%- endif -%}</div>\n        <div class=\"is-need__body\">\n          <h3 class=\"is-need__name\">{{ n_title }}</h3>\n          <p class=\"is-need__text\">{{ n_text }}</p>\n          <span class=\"is-need__cta\">Shop now</span>\n        </div>\n      </a>\n    {%- endif -%}\n  {%- endfor -%}\n{%- endcapture -%}\n{%- if is_need_count >= 2 -%}\n<section class=\"is-needs\">\n  <div class=\"is-needs__inner\">\n    <p class=\"is-needs__eyebrow\">Find the right piece</p>\n    <h2 class=\"is-needs__title\">What does your person need today?</h2>\n    <div class=\"is-needs__grid\">{{ is_need_cards }}</div>\n  </div>\n</section>\n{%- endif -%}"}},"diary_recent":{"type":"diary-recent","settings":{"blog":"behind-the-strength","count":3,"eyebrow":"Behind the Strength","heading":"Real days, honestly told","text":"Short notes from my everyday life with fibromyalgia — the parts no one sees.","read_label":"Read entry","button_label":"Read all entries","background_color":"#f5f0f7"}},"founder_story":{"type":"founder-story","settings":{"image":"shopify://shop_images/Gemini_Generated_Image_mi3zlqmi3zlqmi3z.jpg","image_alt":"Monaliza, founder of Invisible Strong","eyebrow":"Meet the founder","heading":"Why I created Invisible Strong","quote":"For years, I carried a pain no one could see — saying “I'm fine” even when my body was screaming.","text":"<p>Hi, I'm Monaliza, and I live with fibromyalgia. I created Invisible Strong so people like us feel seen, and so the people who love us have a way to say: “I believe you.”</p>","signature":"Monaliza","button_label":"Read My Story","button_link":"shopify://pages/our-story","link_label":"Read the diary","link_url":"shopify://blogs/behind-the-strength","background_color":"#f5f0f7"}}},"order":["hero_jVaWmY","custom_liquid_needs","custom_liquid_zrdA3C","founder_story","custom_liquid_RUqFEM","diary_recent","section_tpiMfG"]}